{
  "schema_version": "1.3",
  "mode": "PRODUCTION_MUTATION_PROTOCOL",
  "purpose": "允许并行诊断与计算，但对共享生产状态实行隔离实施、latest-main重放、文件所有权和串行集成约束。",
  "principles": [
    "parallel_diagnosis_is_allowed",
    "implementation_isolated_by_branch_or_workflow",
    "production_integration_is_serialized",
    "dynamic_state_is_rebuilt_from_latest_main",
    "fact_precedence_must_not_depend_on_last_writer_wins",
    "research_and_shadow_validation_do_not_write_main",
    "formal_fact_documents_use_one_low_level_mutation_gateway"
  ],
  "change_admission": {
    "default": "DO_NOT_MUTATE_UNLESS_CHANGE_VALUE_IS_CLEAR",
    "rules": [
      "diagnose_root_cause_before_mutation; error_location_is_not_root_cause",
      "immediate_mutation_is_allowed_only_when_current_market_or_timing_facts_for_formal_judgment_are_wrong_or_unavailable, account_trade_cash_or_formal_facts_are_wrong_or_unclosed, or a_canonical_production_chain_is_broken_and_cannot_recover_through_existing_mechanisms",
      "when_existing_fallback_self_healing_or_retry_has_correctly_degraded_or_closed_the_incident, default_to_observe; a_single_cron_delay_provider_fallback_transient_push_conflict_notification_failure_or_already_closed_self_heal_is_not_by_itself_a_reason_to_mutate_production",
      "every_bug_fix_must_validate_the_original_failure_case, adjacent_state_or_session_boundaries, and the previously_normal_case",
      "after_a_non_emergency_production_semantic_change_is_integrated, prefer_one_natural_production_cycle_before_stacking_another_semantic_change; only_a_current_trade_account_market_fact_or_canonical_runtime_failure_may_interrupt_this_observation",
      "minimal_fix_means_the_smallest_complete_root_cause_fix_not_the_smallest_diff; do_not_optimize_for_fewer_changed_lines_if_that_leaves_known_adjacent_breakpoints_or_pushes_the_same_defect_downstream",
      "fix_the_defect_at_the_highest_valid_canonical_owner; when_one_upstream_or_canonical_owner_can_resolve_the_fact_or_state_error, downstream_consumers_must_not_each_add_compensating_exceptions_fallbacks_or_special_branches",
      "if_a_second_production_patch_is_needed_for_the_same_or_suspected_same_root_cause, stop_local_patching_and_reopen_end_to_end_root_cause_analysis_across_input_owner_state_transition_downstream_consumers_and_adjacent_sessions; continue_only_if_the_second_issue_is_proven_independent_or_the_complete_root_cause_fix_is_identified",
      "a_bug_fix_must_preserve_unaffected_contracts_by_default; do_not_bundle_unrelated_changes_to_schedule_frequency_thresholds_provider_priority_check_scope_permissions_trading_rules_or_other_behavior unless_they_are_proven_part_of_the_same_root_cause",
      "during_A_share_continuous_trading_hours, production_script_config_workflow_or_data_standard_changes_are_allowed_only_for_FIX_NOW; OBSERVE_and_DO_NOT_FIX_items_wait_until_noncritical_hours while_market_account_trade_state_and_canonical_self_healing_may_continue_normally",
      "multiple_symptoms_from_one_root_cause_must_be_resolved_as_one_coherent_root_cause_fix_across_the_complete_affected_state_chain; symptom_by_symptom_patch_chains_that_mask_an_upstream_defect_with_local_exceptions_temporary_fallbacks_or_special_cases_are_forbidden"
    ],
    "decision_outcomes": [
      "FIX_NOW",
      "OBSERVE",
      "DO_NOT_FIX"
    ],
    "decision_rule": "如果不能证明现在修改的生产收益高于不修改，默认不修改；该默认只限制维护变更，不阻止影响正式交易判断、账户/成交事实、行情事实或canonical生产运行的真实故障及时恢复。",
    "execution_boundary": "用户提出修复要求不自动等于允许修改生产；ChatGPT/Codex在生产变更前必须先完成问题事实、canonical owner、根因、当前影响、现有恢复是否充分和修改必要性的判断。FIX_NOW进入现有最小修复链；OBSERVE/DO_NOT_FIX不创建生产修改。"
  },
  "writer_requirements": {
    "require_concurrency_group": true,
    "require_latest_main_sync_before_push": true,
    "forbid_force_push_to_main": true,
    "latest_main_sync_markers": [
      "git pull --rebase origin main",
      "git reset --hard origin/main",
      "git rebase origin/main"
    ]
  },
  "single_owner_files": {
    "data/state/system_consistency.json": ".github/workflows/system-consistency.yml",
    "ETF规则_MASTER.md": "NO_AUTOMATIC_WORKFLOW"
  },
  "formal_file_mutation_contract": {
    "canonical_gateway": "scripts/formal_file_mutation_gateway.py",
    "allowed_fact_files": [
      "ETF当前状态_DASHBOARD.md",
      "ETF市场行情档案_2026.md",
      "ETF交易复盘与经验库_2026.md"
    ],
    "forbidden_rule_file": "ETF规则_MASTER.md",
    "registered_callers": [
      "scripts/sync_formal_files.py",
      "scripts/process_state_sync_request.py",
      "scripts/apply_trade_fact_correction.py"
    ],
    "rule": "业务脚本可以分别负责账户同步、成交/复盘事件和已确认费用纠错，但对三份人类可读正式事实文件的低层managed-block/upsert/write必须统一经过canonical gateway；gateway绝不允许写MASTER。"
  },
  "shared_writer_families": [
    {
      "family_id": "A_SHARE_CORE_SNAPSHOT",
      "members": [
        ".github/workflows/market-snapshot.yml",
        ".github/workflows/opening-auction-current-fallback.yml"
      ],
      "required_concurrency_token": "etf-market-snapshot-${{ github.ref }}",
      "reason": "两条链使用同一A股核心producer并可能写CURRENT/runtime及快照，必须共享串行队列。"
    }
  ],
  "nonproduction_validation_workflows": {
    ".github/workflows/akshare-capability-poc.yml": {
      "artifact_path": "data/state/akshare_poc.json",
      "rule": "PoC结果仅作为短期验证证据，不持久化main。"
    },
    ".github/workflows/minute-source-poc.yml": {
      "artifact_path": "data/state/minute_source_poc.json",
      "rule": "分钟源能力验证只保留Actions artifact；正式启用必须另走生产转化。"
    },
    ".github/workflows/minute-path-shadow.yml": {
      "artifact_path": "data/state/minute_path_features.json",
      "rule": "shadow输出不属于正式decision context；只做短期artifact留档，不直接写main。"
    }
  },
  "state_file_contracts": {
    "data/state/CURRENT.json": {
      "state_class": "CANONICAL_MARKET_STATE",
      "canonical_builder": "scripts/cloud_runner_snapshot.py",
      "canonical_writers": [
        ".github/workflows/market-snapshot.yml",
        ".github/workflows/opening-auction-current-fallback.yml"
      ],
      "bounded_repair_writers": {
        ".github/workflows/self-healing-watchdog.yml": {
          "required_script": "scripts/runtime_self_heal.py",
          "allowed_mutation": "CURRENT.rules_version only when MASTER metadata drift is detected"
        }
      },
      "rule": "行情价格、时点、快照指针和market phase只能来自canonical snapshot producer；自愈不得重建行情事实。"
    },
    "data/state/runtime_health.json": {
      "state_class": "CANONICAL_A_SHARE_RUNTIME_HEALTH",
      "canonical_builder": "scripts/cloud_runner_snapshot.py",
      "canonical_writers": [
        ".github/workflows/market-snapshot.yml",
        ".github/workflows/opening-auction-current-fallback.yml"
      ],
      "rule": "A股runtime health随canonical snapshot producer生成；海外、通知、研究和一致性workflow不得持久化该文件。"
    },
    "data/state/decision_context.json": {
      "state_class": "DERIVED_REBUILDABLE_STATE",
      "canonical_builder": "scripts/build_state_context.py",
      "allowed_writers": [
        ".github/workflows/market-snapshot.yml",
        ".github/workflows/opening-auction-current-fallback.yml",
        ".github/workflows/self-healing-watchdog.yml"
      ],
      "rule": "允许多个受控入口触发，但所有持久化版本必须由同一个canonical builder从当时最新正式事实重建，不允许workflow手工拼接。"
    },
    "data/state/query_context.json": {
      "state_class": "DERIVED_REBUILDABLE_STATE",
      "canonical_builder": "scripts/build_query_context.py",
      "allowed_writers": [
        ".github/workflows/market-snapshot.yml",
        ".github/workflows/opening-auction-current-fallback.yml",
        ".github/workflows/overseas-preopen-pulse.yml",
        ".github/workflows/self-healing-watchdog.yml"
      ],
      "rule": "允许A股核心、海外刷新和自愈重建，但所有持久化版本必须调用同一个canonical builder；system-consistency只可临时重建用于审计，不应把query_context作为自身owned state提交。"
    }
  },
  "fact_precedence": [
    "ETF规则_MASTER.md > 派生状态与历史聊天",
    "用户确认或券商确认的实际成交 > 辅助权益/历史账本重构",
    "最新有效账户事实 > 旧Dashboard或旧缓存",
    "更新的正式复盘事实 > 辅助历史重构",
    "真实provider时点 > workflow计划时间",
    "最新main上的正式源文件 > 旧分支生成的动态状态"
  ],
  "integration_sequence": [
    "analyze_in_parallel",
    "implement_in_isolation",
    "merge_one_change",
    "wait_for_latest_main_consistency",
    "rebase_or_replay_next_change_on_latest_main",
    "run_combined_end_to_end_validation"
  ]
}
