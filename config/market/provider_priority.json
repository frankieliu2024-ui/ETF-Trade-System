  "dynamic_scope_policy": {
    "A_SHARE_QUERY_TIME_INDUSTRY_STOCK": {
      "primary": "tencent_qq",
      "fallback": [
        "hithink_finance"
      ],
      "direct_only": true,
      "eastmoney_status": "NOT_YET_GENERICALLY_WIRED_FOR_ARBITRARY_STOCKS",
      "rule": "仅查询时按当前产业链/行业假设临时调用，不写入固定观察池；腾讯失败时允许同花顺直接行情兜底。"
    }
  },
  "tencent_expansion_policy": {
    "production_enabled": [
      "A_SHARE_INDEX",
      "A_SHARE_ETF",
      "A_SHARE_ACCOUNT_STOCK",
      "A_SHARE_QUERY_TIME_INDUSTRY_STOCK"
    ],
    "next_verified_scope": [
      "OVERSEAS_INDEX_AND_STOCK_SHADOW_VALIDATION"
    ],
    "overseas_status": "SHADOW_VALIDATION_REQUIRED_BEFORE_PRODUCTION",
    "overseas_rule": "当前tencent_quote.py仅解析sh/sz六位代码并按A股字段语义校验；海外指数、港股、美股、日韩台对象不得因A股表现良好而直接升为生产主源。必须逐对象验证provider symbol、时间戳、OHLC/成交量字段语义、交易阶段和稳定性后再进入object_fallback_policy。",
    "promotion_rule": "至少跨多个真实交易节点验证低延迟、字段语义一致、时间戳真实且质量PASS后，才可由candidate提升为verified direct source。"
  },
  "us_extended_hours": {
    "base_proxies": [
      "QQQ",
      "SOXX"
    ],
    "conditional_industry_stocks": "dynamic_only",
    "sessions_et": {
      "PRE_MARKET": "04:00-09:30",
      "REGULAR": "09:30-16:00",
      "POST_MARKET": "16:00-20:00"
    },
    "rule": "NDX/SOX现金指数与美股扩展时段分开解释；QQQ/SOXX及条件个股扩展时段只作前置信号，不直接生成A股ETF动作。"
  },
  "time_alignment": {
    "required": true,
    "fields": [
      "as_of_beijing",
      "market_timezone",
      "as_of_local",
      "market_phase",
      "time_relation_to_a_share"
    ],
    "rule": "跨市场证据按各市场实际时点解释；美国现金盘、盘后、下一交易日盘前必须分开；亚洲市场按同日盘中/同日已收盘/上一交易日区分。"
  },
  "notes": {
    "a_share_index_000001": "Eastmoney secid=1.000001映射为个股而非上证指数，暂不作为直接fallback；腾讯主源失败时仅走同花顺直接指数备源。",
    "hstech": "东方财富124.HSTECH已在真实交易时段验证为低延迟直接行情，正式提升为主源。objects字段保留历史审计枚举顺序；实际主备权威以object_fallback_policy.primary及build_overseas_context configured_primary为准；513180仅为最后代理。",
    "etf_fallback": "ETF生产意图为腾讯→同花顺→东方财富；运行代码必须与本对象级政策保持一致。",
    "tencent_a_share_industry": "查询时A股产业链个股正式启用腾讯主源；不建立固定个股池，仍由当前ETF/行业假设动态发现。",
    "a_share_index_000688": "科创50指数（000688）正式纳入指数层；腾讯sh000688已完成直接映射验证，为生产主源；同花顺000688.SH作为A股指数直接备源。东方财富映射未完成对象级验证前不加入fallback。",
    "ndx_direct_fallback": "纳斯达克100指数（NDX）保留Yahoo ^NDX主源，并启用东方财富100.NDX100作为经真实REGULAR时段对象、价格、时间戳与并行延迟验证的直接备源；仅在主源不可用、质量失败或开放交易阶段明显延迟时切换。错误映射100.NDX禁止使用。",
    "asia_direct_fallback": "日经225指数（N225）、韩国综合指数（KOSPI）、台湾加权指数（TWII）保留Yahoo主源；根据用户已确认的东方财富对象映射，分别启用100.N225、100.KS11、100.TWII作为直接备源。N225仍保留513520仅作最后ETF代理。"
  },
  "audit_scope": "对象级主源失败后仅调用已验证直接备源；未验证映射保留SINGLE_SOURCE_RISK，不以代理冒充直连"
}
