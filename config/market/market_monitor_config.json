{
  "version": "V1.2",
  "purpose": "数据能力与三层市场监测配置，不产生交易判断",
  "priority": ["direct_index", "reliable_alternative", "etf_proxy"],
  "providers": {
    "hithink_finance": {"priority": 1, "scope": "A股ETF、A股指数及已覆盖直接指数（含HS2083）", "requires_key": true},
    "yahoo_chart_api": {"priority": 1, "scope": "海外与亚洲指数、海外个股、商品辅助", "requires_key": false, "adjusted": false},
    "akshare": {"priority": 2, "scope": "候选多源适配器", "requires_key": false, "not_live_verified": true},
    "pandas_datareader": {"priority": 2, "scope": "宏观/因子数据候选", "not_live_verified": true},
    "investpy": {"priority": 3, "scope": "不优先候选", "stale_upstream": true}
  },
  "formal_index_layer": {
    "required_objects": ["000001.SH", "399006.SZ", "NDX", "SOX", "N225", "KOSPI", "TWII", "HSTECH"],
    "rule": "正式决策默认复核全部required_objects。单一对象数据源失败可DEGRADED/FAILED或使用明确代理，但不得静默省略。指数层只提供市场环境、风险背景、增强或反向证据，不单独生成ETF动作。",
    "time_alignment": {
      "required_fields": ["market_timezone", "as_of", "market_phase", "time_relation_to_a_share"],
      "us_cash_indices": "A股交易时段通常使用上一美股交易时段的已完成现金指数信息，禁止表述为与A股当前盘中同步。",
      "asia_indices": "按同日盘中、同日已收盘或上一交易日分别解释；日期相同不等于时点同步。",
      "hstech": "A股15:00收盘时香港市场通常尚未完成当日收盘，必须按实际market_phase和as_of解释。"
    }
  },
  "monitoring_layers": {
    "index_monitor": {
      "mode": "FORMAL_FIXED_LAYER",
      "required_objects": ["000001.SH", "399006.SZ", "NDX", "SOX", "N225", "KOSPI", "TWII", "HSTECH"],
      "conditional_objects": ["KOSDAQ", "GOLD", "DXY", "SPX", "VIX"],
      "rule": "正式指数层固定；条件对象仅按具体假设调用。"
    },
    "etf_monitor": {
      "mode": "HOLDING_PLUS_OBSERVATION",
      "holding_source": "当前账户事实与Dashboard",
      "observation_source": "当前观察ETF清单",
      "rule": "ETF层日常只分持仓ETF与观察ETF；二者均持续获取行情和参加统一扫描。观察身份不自动产生Trial/Confirm权限。"
    },
    "stock_monitor": {
      "mode": "DYNAMIC_ACCOUNT_PLUS_QUERY_TIME_INDUSTRY",
      "default_account_source": "data/state/account_fact.json",
      "role_memory": "data/state/asset_roles.json",
      "runtime_context": "data/state/stock_context.json",
      "policy": "config/market/stock_monitor_policy.json",
      "fixed_default_codes": [],
      "rule": "默认个股监测不固定宁德时代、工业富联或任何股票代码，而是从当日账户实际非ETF持仓动态生成。已确认IPO_BASE_STOCK进入打新底仓个股监测；新出现但用途未知的个股只标记UNCLASSIFIED_STOCK并要求一次确认。产业链个股不设固定名单，按ETF候选、持仓、行业冲击或传导分析需要临时发现和调用。",
      "conditional_industry_scope": ["A_SHARE", "US", "HK", "KR", "TW", "JP", "OTHER_VERIFIED"],
      "examples_are_not_watchlist": true
    }
  },
  "classes": {
    "A": {"name": "正式指数层", "objects": [
      {"id":"000001.SH","name":"上证指数","preferred_source":"hithink_finance","status":"ACTIVE"},
      {"id":"399006.SZ","name":"创业板指","preferred_source":"hithink_finance","status":"ACTIVE"},
      {"id":"NDX","name":"纳斯达克100指数","preferred_source":"yahoo_chart_api","status":"ACTIVE"},
      {"id":"SOX","name":"费城半导体指数","preferred_source":"yahoo_chart_api","status":"ACTIVE"},
      {"id":"N225","name":"日经225指数","preferred_source":"yahoo_chart_api","status":"ACTIVE"},
      {"id":"KOSPI","name":"韩国综合指数","preferred_source":"yahoo_chart_api","status":"ACTIVE"},
      {"id":"TWII","name":"台湾加权指数","preferred_source":"yahoo_chart_api","status":"ACTIVE"},
      {"id":"HSTECH","name":"恒生科技指数","preferred_source":"hithink_finance:HS2083","fallback_source":"yahoo_chart_api:^HSTECH|513180 proxy","status":"ACTIVE_WITH_FALLBACK"}
    ]},
    "B": {"name": "ETF层", "mode": "HOLDING_PLUS_OBSERVATION", "note": "具体ETF状态由当前账户与观察清单维护，不在本配置复制固定交易结论。"},
    "C": {"name": "个股层", "mode": "DYNAMIC", "note": "打新底仓从账户动态识别；产业链个股按主题临时调用，不维护固定名单。"}
  },
  "guardrails": {
    "no_trade_rules": true,
    "no_trade_actions": true,
    "proxy_cannot_replace_direct_index_permanently": true,
    "formal_index_objects_cannot_be_silently_omitted": true,
    "cross_market_time_alignment_required": true,
    "different_market_dates_or_phases_cannot_be_called_synchronous": true,
    "no_fixed_ipo_base_stock_codes": true,
    "no_fixed_industry_stock_watchlist": true,
    "new_account_stock_role_requires_confirmation": true
  }
}
