{
  "version": "V1.4",
  "purpose": "数据能力与三层市场监测配置，不产生交易判断",
  "priority": [
    "direct_index",
    "reliable_alternative",
    "etf_proxy"
  ],
  "providers": {
    "tencent_qq": {
      "priority": 1,
      "scope": "已验证A股指数、ETF、账户个股及查询时A股产业链个股实时快照",
      "requires_key": false,
      "adjusted": false
    },
    "eastmoney_push2": {
      "priority": 1,
      "scope": "恒生科技指数直接主源；已验证A股ETF/个股/部分指数直接备源",
      "requires_key": false,
      "adjusted": false
    },
    "hithink_finance": {
      "priority": 2,
      "scope": "A股ETF、A股指数及已覆盖直接指数备源/审计源",
      "requires_key": true
    },
    "yahoo_chart_api": {
      "priority": 1,
      "scope": "海外与亚洲指数、海外个股、商品辅助；HSTECH为备源",
      "requires_key": false,
      "adjusted": false
    },
    "akshare": {
      "priority": 2,
      "scope": "候选多源适配器",
      "requires_key": false,
      "not_live_verified": true
    },
    "pandas_datareader": {
      "priority": 2,
      "scope": "宏观/因子数据候选",
      "not_live_verified": true
    },
    "investpy": {
      "priority": 3,
      "scope": "不优先候选",
      "stale_upstream": true
    }
  },
  "formal_index_layer": {
    "required_objects": [
      "000001.SH",
      "399006.SZ",
      "000688.SH",
      "NDX",
      "SOX",
      "N225",
      "KOSPI",
      "TWII",
      "HSTECH"
    ],
    "rule": "正式决策默认复核全部required_objects。单一对象数据源失败可DEGRADED/FAILED或使用明确代理，但不得静默省略。指数层只提供市场环境、风险背景、增强或反向证据，不单独生成ETF动作。",
    "time_alignment": {
      "required_fields": [
        "market_timezone",
        "as_of",
        "market_phase",
        "time_relation_to_a_share"
      ],
      "us_cash_indices": "A股交易时段通常使用上一美股交易时段的已完成现金指数信息，禁止表述为与A股当前盘中同步。",
      "asia_indices": "按同日盘中、同日已收盘或上一交易日分别解释；日期相同不等于时点同步。",
      "hstech": "东方财富124.HSTECH为正式直接主源；A股15:00收盘时香港市场通常尚未完成当日收盘，必须按实际market_phase和as_of解释。"
    }
  },
  "monitoring_layers": {
    "index_monitor": {
      "mode": "FORMAL_FIXED_LAYER",
      "required_objects": [
        "000001.SH",
        "399006.SZ",
        "000688.SH",
        "NDX",
        "SOX",
        "N225",
        "KOSPI",
        "TWII",
        "HSTECH"
      ],
      "conditional_objects": [
        "KOSDAQ",
        "GOLD",
        "DXY",
        "SPX",
        "VIX"
      ],
      "rule": "正式指数层固定；条件对象仅按具体假设调用。"
    },
    "etf_monitor": {
      "mode": "HOLDING_PLUS_OBSERVATION",
      "holding_source": "当前账户事实与Dashboard",
      "observation_source": "当前观察ETF清单",
      "rule": "ETF层日常只分持仓ETF与观察ETF；二者均持续获取行情和参加统一扫描。观察身份不自动产生Trial/Confirm权限。"
    },
    "stock_monitor": {
      "mode": "DYNAMIC_ACCOUNT_PLUS_QUERY_TIME_INDUSTRY",
      "default_account_source": "data/state/account_fact.json",
      "role_memory": "data/state/asset_roles.json",
      "runtime_context": "data/state/stock_context.json",
      "policy": "config/market/stock_monitor_policy.json",
      "fixed_default_codes": [],
      "rule": "默认个股监测不固定任何股票代码，而是从当日账户实际非ETF持仓动态生成。A股账户个股与查询时临时产业链个股均正式使用腾讯实时主源；产业链个股仍按当前ETF/行业假设临时发现，不建立固定池。海外个股继续按既有海外源，未完成对象级验证前不得直接把腾讯升为生产源。",
      "conditional_industry_scope": [
        "A_SHARE",
        "US",
        "HK",
        "KR",
        "TW",
        "JP",
        "OTHER_VERIFIED"
      ],
      "examples_are_not_watchlist": true
    }
  },
  "classes": {
    "A": {
      "name": "正式指数层",
      "objects": [
        {
          "id": "000001.SH",
          "name": "上证指数",
          "preferred_source": "tencent_qq",
          "fallback_source": "hithink_finance",
          "status": "ACTIVE"
        },
        {
          "id": "399006.SZ",
          "name": "创业板指",
          "preferred_source": "tencent_qq",
          "fallback_source": "hithink_finance|eastmoney_push2",
          "status": "ACTIVE_WITH_FALLBACK"
        },
        {
          "id": "000688.SH",
          "name": "科创50指数",
          "preferred_source": "tencent_qq",
          "fallback_source": "hithink_finance",
          "status": "ACTIVE_WITH_FALLBACK"
        },
        {
          "id": "NDX",
          "name": "纳斯达克100指数",
          "preferred_source": "yahoo_chart_api",
          "status": "ACTIVE"
        },
        {
          "id": "SOX",
          "name": "费城半导体指数",
          "preferred_source": "yahoo_chart_api",
          "status": "ACTIVE"
        },
        {
          "id": "N225",
          "name": "日经225指数",
          "preferred_source": "yahoo_chart_api",
          "status": "ACTIVE"
        },
        {
          "id": "KOSPI",
          "name": "韩国综合指数",
          "preferred_source": "yahoo_chart_api",
          "status": "ACTIVE"
        },
        {
          "id": "TWII",
          "name": "台湾加权指数",
          "preferred_source": "yahoo_chart_api",
          "status": "ACTIVE"
        },
        {
          "id": "HSTECH",
          "name": "恒生科技指数",
          "preferred_source": "eastmoney_push2:124.HSTECH",
          "fallback_source": "yahoo_chart_api:HSTECH.HK|hithink_finance:HS2083|513180 proxy",
          "status": "ACTIVE_WITH_FALLBACK"
        }
      ]
    },
    "B": {
      "name": "ETF层",
      "mode": "HOLDING_PLUS_OBSERVATION",
      "note": "具体ETF状态由当前账户与观察清单维护；生产实时主源统一为腾讯，备源按provider_priority对象级策略。"
    },
    "C": {
      "name": "个股层",
      "mode": "DYNAMIC",
      "note": "A股账户个股及查询时产业链个股腾讯主源；海外个股继续使用既有海外源，腾讯海外覆盖仅进入对象级影子验证。"
    }
  },
  "provider_expansion": {
    "tencent_current_production": [
      "A_SHARE_INDEX",
      "A_SHARE_ETF",
      "A_SHARE_ACCOUNT_STOCK",
      "A_SHARE_QUERY_TIME_INDUSTRY_STOCK"
    ],
    "tencent_next_candidate": [
      "OVERSEAS_INDEX_AND_STOCK_SHADOW_VALIDATION"
    ],
    "tencent_overseas": "SHADOW_VALIDATION_REQUIRED",
    "rule": "不得把A股接口稳定性直接外推到海外代码体系。海外指数/个股必须逐对象验证symbol映射、时间戳、OHLC字段、交易阶段、成交量语义和多节点稳定性后才可升级。"
  },
  "guardrails": {
    "no_trade_rules": true,
    "no_trade_actions": true,
    "proxy_cannot_replace_direct_index_permanently": true,
    "formal_index_objects_cannot_be_silently_omitted": true,
    "cross_market_time_alignment_required": true,
    "different_market_dates_or_phases_cannot_be_called_synchronous": true,
    "no_fixed_ipo_base_stock_codes": true,
    "no_fixed_industry_stock_watchlist": true,
    "new_account_stock_role_requires_confirmation": true,
    "unverified_tencent_overseas_cannot_be_production_primary": true
  }
}
