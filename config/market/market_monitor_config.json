{
  "version": "V1.6",
  "purpose": "数据能力与三层市场监测配置，不产生交易判断",
  "priority": [
    "direct_index",
    "reliable_alternative",
    "etf_proxy"
  ],
  "providers": {
    "tencent_qq": {
      "priority": 1,
      "scope": "已验证A股指数、ETF、账户个股及查询时A股产业链个股实时快照",
      "requires_key": false,
      "adjusted": false
    },
    "eastmoney_push2": {
      "priority": 1,
      "scope": "恒生科技指数直接主源；已验证A股ETF/个股/部分指数直接备源；纳斯达克100指数（NDX）及已确认日经225指数（N225）、韩国综合指数（KOSPI）、台湾加权指数（TWII）对象级直接备源",
      "requires_key": false,
      "adjusted": false
    },
    "hithink_finance": {
      "priority": 2,
      "scope": "A股ETF、A股指数及已覆盖直接指数备源/审计源",
      "requires_key": true
    },
    "yahoo_chart_api": {
      "priority": 1,
      "scope": "海外与亚洲指数、海外个股、商品辅助；HSTECH为备源",
      "requires_key": false,
      "adjusted": false
    },
    "akshare": {
      "priority": 2,
      "scope": "候选多源适配器",
      "requires_key": false,
      "not_live_verified": true
    },
    "pandas_datareader": {
      "priority": 2,
      "scope": "宏观/因子数据候选",
      "not_live_verified": true
    },
    "investpy": {
      "priority": 3,
      "scope": "不优先候选",
      "stale_upstream": true
    }
  },
  "formal_index_layer": {
    "required_objects": [
      "000001.SH",
      "399006.SZ",
      "000688.SH",
      "NDX",
      "SOX",
      "N225",
      "KOSPI",
      "TWII",
      "HSTECH"
    ],
    "rule": "正式决策默认复核全部required_objects。单一对象数据源失败可DEGRADED/FAILED或使用明确代理，但不得静默省略。指数层只提供市场环境、风险背景、增强或反向证据，不单独生成ETF动作。",
    "time_alignment": {
      "required_fields": [
        "market_timezone",
        "as_of",
        "market_phase",
        "time_relation_to_a_share"
      ],
      "us_cash_indices": "A股交易时段通常使用上一美股交易时段的已完成现金指数信息，禁止表述为与A股当前盘中同步。",
      "asia_indices": "按同日盘中、同日已收盘或上一交易日分别解释；日期相同不等于时点同步。",
      "hstech": "东方财富124.HSTECH为正式直接主源；A股15:00收盘时香港市场通常尚未完成当日收盘，必须按实际market_phase和as_of解释。"
    }
  },
  "monitoring_layers": {
    "index_monitor": {
      "mode": "FORMAL_FIXED_LAYER",
      "required_objects": [
        "000001.SH",
        "399006.SZ",
        "000688.SH",
        "NDX",
        "SOX",
        "N225",
        "KOSPI",
        "TWII",
        "HSTECH"
      ],
      "conditional_objects": [
        "KOSDAQ",
        "GOLD",
        "DXY",
        "SPX",
        "VIX"
      ],
      "rule": "正式指数层固定；条件对象仅按具体假设调用。"
    },
    "etf_monitor": {
      "mode": "HOLDING_PLUS_OBSERVATION",
      "holding_source": "当前账户事实与Dashboard",
      "observation_source": "当前观察ETF清单",
      "rule": "ETF层日常只分持仓ETF与观察ETF；二者均持续获取行情和参加统一扫描。观察身份不自动产生Trial/Confirm权限。"
    },
    "stock_monitor": {
      "mode": "DYNAMIC_ACCOUNT_PLUS_QUERY_TIME_INDUSTRY",
      "default_account_source": "data/state/account_fact.json",
      "role_memory": "data/state/asset_roles.json",
      "runtime_context": "data/state/stock_context.json",
      "policy": "config/market/stock_monitor_policy.json",
      "fixed_default_codes": [],
      "rule": "默认个股监测不固定任何股票代码，而是从当日账户实际非ETF持仓动态生成。A股账户个股与查询时临时产业链个股均正式使用腾讯实时主源；产业链个股仍按当前ETF/行业假设临时发现，不建立固定池。海外个股继续按既有海外源，未完成对象级验证前不得直接把腾讯升为生产源。",
      "conditional_industry_scope": [
        "A_SHARE",
        "US",
        "HK",
        "KR",
        "TW",
        "JP",
        "OTHER_VERIFIED"
      ],
      "examples_are_not_watchlist": true
    }
  },
  "classes": {
    "A": {
      "name": "正式指数层",
      "objects": [
        {
          "id": "000001.SH",
          "name": "上证指数",
          "preferred_source": "tencent_qq",
          "fallback_source": "hithink_finance",
          "status": "ACTIVE"
        },
        {
          "id": "399006.SZ",
          "name": "创业板指",
          "preferred_source": "tencent_qq",
          "fallback_source": "hithink_finance|eastmoney_push2",
          "status": "ACTIVE_WITH_FALLBACK"
        },
        {
          "id": "000688.SH",
          "name": "科创50指数",
          "preferred_source": "tencent_qq",
          "fallback_source": "hithink_finance",
          "status": "ACTIVE_WITH_FALLBACK"
        },
        {
          "id": "NDX",
          "name": "纳斯达克100指数",
          "preferred_source": "yahoo_chart_api",
          "status": "ACTIVE_WITH_FALLBACK",
          "fallback_source": "eastmoney_push2:100.NDX100"
        },
        {
          "id": "SOX",
          "name": "费城半导体指数",
          "preferred_source": "yahoo_chart_api",
          "fallback_source": "ETF_PROXY_SOXQ",
          "status": "ACTIVE_WITH_FALLBACK"
        },
        {
          "id": "N225",
          "name": "日经225指数",
          "preferred_source": "eastmoney_push2delay:100.N225",
          "status": "ACTIVE_WITH_FALLBACK",
          "fallback_source": "eastmoney_push2:100.N225|yahoo_chart_api|ETF_PROXY_513520"
        },
        {
          "id": "KOSPI",
          "name": "韩国综合指数",
          "preferred_source": "naver_finance:KOSPI",
          "status": "ACTIVE_WITH_FALLBACK",
          "fallback_source": "eastmoney_push2delay:100.KS11|eastmoney_push2:100.KS11|yahoo_chart_api"
        },
        {
          "id": "TWII",
          "name": "台湾加权指数",
          "preferred_source": "twse_mis:tse_t00.tw",
          "status": "ACTIVE_WITH_FALLBACK",
          "fallback_source": "eastmoney_push2delay:100.TWII|eastmoney_push2:100.TWII|yahoo_chart_api"
        },
        {
          "id": "HSTECH",
          "name": "恒生科技指数",
          "preferred_source": "eastmoney_push2:124.HSTECH",
          "fallback_source": "yahoo_chart_api:HSTECH.HK|hithink-finance:HS2083|ETF_PROXY_513180",
          "status": "ACTIVE_WITH_FALLBACK"
        }
      ]
    },
    "B": {
      "name": "ETF层",
      "mode": "HOLDING_PLUS_OBSERVATION",
      "note": "具体ETF状态由当前账户与观察清单维护；生产实时主源统一为腾讯，备源按provider_priority对象级策略。"
    },
    "C": {
      "name": "个股层",
      "mode": "DYNAMIC",
      "note": "A股账户个股及查询时产业链个股腾讯主源；海外个股继续使用既有海外源，腾讯海外覆盖仅进入对象级影子验证。"
    }
  },
  "provider_expansion": {
    "tencent_current_production": [
      "A_SHARE_INDEX",
      "A_SHARE_ETF",
      "A_SHARE_ACCOUNT_STOCK",
      "A_SHARE_QUERY_TIME_INDUSTRY_STOCK"
    ],
    "tencent_next_candidate": [
      "OVERSEAS_INDEX_AND_STOCK_SHADOW_VALIDATION"
    ],
    "tencent_overseas": "SHADOW_VALIDATION_REQUIRED",
    "rule": "不得把A股接口稳定性直接外推到海外代码体系。海外指数/个股必须逐对象验证symbol映射、时间戳、OHLC字段、交易阶段、成交量语义和多节点稳定性后才可升级。"
  },
  "guardrails": {
    "no_trade_rules": true,
    "no_trade_actions": true,
    "proxy_cannot_replace_direct_index_permanently": true,
    "formal_index_objects_cannot_be_silently_omitted": true,
    "cross_market_time_alignment_required": true,
    "different_market_dates_or_phases_cannot_be_called_synchronous": true,
    "no_fixed_ipo_base_stock_codes": true,
    "no_fixed_industry_stock_watchlist": true,
    "new_account_stock_role_requires_confirmation": true,
    "unverified_tencent_overseas_cannot_be_production_primary": true
  },
  "vnext_contracts": {
    "schema_version": "VNext-Phase2-1.0",
    "decision_boundary": "metadata_and_eligibility_contract_only; does_not_generate_trade_actions_or_rankings",
    "monitoring_layers": {
      "layer_1_external_drivers_cross_market_state": {
        "mode": "BASE_PLUS_TRIGGERED_EXPANSION",
        "fact_domains": ["global_risk", "overseas_industry_theme", "commodity", "rates", "fx", "macro_policy_events", "cross_market_assets_and_supply_chain"],
        "default_scope": "low_cost_base_state",
        "expansion_trigger": "only_when_anomaly_or_current_exposure_or_candidate_may_change_risk_opportunity_sell_or_capital_allocation",
        "action_boundary": "evidence_and_trigger_selection_only"
      },
      "layer_2_china_internal_market_state": {
        "mode": "BASE_PLUS_TRIGGERED_EXPANSION",
        "fact_domains": ["index", "breadth", "style", "industry_theme", "liquidity_turnover", "capital_flow", "anomaly", "external_confirmation_state"],
        "availability": {"BASE": "low_cost_stable", "TRIGGERED": "targeted_evidence", "OPTIONAL_ENHANCING": "must_not_block_decision"},
        "action_boundary": "market_fact_and_qualification_only"
      },
      "layer_3_etf_opportunity_and_capital_state": {
        "fact_domains": ["full_market_discovery", "holding_etf", "observation_etf", "temporary_discovery_candidate", "cash", "releasable_low_efficiency_capital", "holding_additional_capital"],
        "candidate_pool_owner": "scripts/formal_etf_opportunity_discovery.py",
        "capital_competition_owner": "MASTER_and_ChatGPT",
        "action_boundary": "eligibility_inputs_only_until_MASTER_decision"
      }
    },
    "transmission_metadata": {
      "fields": ["transmission_tags", "external_drivers", "china_feedback", "etf_family", "trigger_metadata"],
      "owner": "market_monitor_config_and_formal_discovery_evidence",
      "purpose": "select_targeted_evidence_only",
      "forbidden_uses": ["hidden_score", "ranking", "trial_confirm_sell", "amount", "order", "persistent_exposure_state"]
    },
    "evidence_contract": {
      "version": "1.0",
      "required_fields": ["object", "fact_type", "source", "provider_as_of", "received_at", "market_phase", "actual_age", "quality", "PIT", "freshness", "decision_eligible", "execution_eligible", "fallback_status", "decision_use", "evidence_identity"],
      "decision_use": ["DECISION_CRITICAL", "DECISION_ENHANCING", "CONTEXT_ONLY", "RESEARCH"],
      "eligibility_rule": "fact_type_x_market_phase_x_decision_use; preserve_provider_as_of_and_actual_age; provider_call_time_is_not_realtime",
      "execution_rule": "execution_eligible_is_independent_from_decision_eligible",
      "backward_compatibility": "legacy_fields_remain_accepted; consumers may derive missing optional fields as UNKNOWN; missing critical provenance is fail_closed"
    },
    "discovery_evidence_identity": {
      "owner": "scripts/formal_etf_opportunity_discovery.py",
      "components": ["market_date", "market_node", "universe_identity", "decision_relevant_market_delta", "required_history_end_date"],
      "reuse_rule": "reuse_only_after_identity_and_delta_validation",
      "snapshot_filename_rule": "snapshot_filename_alone_is_not_identity",
      "coverage_rule": "full_market_boundary_remains_true; observation_capacity_is_resource_protection_not_top_n_ranking",
      "failure_rule": "missing_identity_or_invalid_delta_must_refresh_or_fail_closed"
    },
    "discovery_entrypoints": {
      "cross_sectional": ["full_market_etf", "cheap_qualification", "family_or_information_class", "history", "candidate_eligibility"],
      "triggered": ["external_or_china_or_commodity_or_flow_anomaly", "transmission_metadata", "relevant_etf_family", "etf_validation"],
      "convergence": "both_entries_share_one_candidate_eligibility_pool_and_one_MASTER_qualification_chain",
      "forbidden": ["second_discovery_engine", "direct_trade_action", "fixed_observation_pool"]
    },
    "decision_readiness": {
      "DECISION_READY": ["risk_permission", "all_holding_sell_hold", "holding_additional_judgment", "full_market_opportunity_comparison", "observation_and_temporary_candidate_comparison", "cash", "releasable_capital", "trial_confirm", "amount", "funding_source", "post_action_cash", "future_trial_confirm_capacity", "concentration_and_common_risk", "next_unit_capital_use"],
      "FULL_SYSTEM_READY": ["dashboard", "archive", "review", "notification_enrichment", "experience", "research_enrichment", "contribution_audit", "other_projections"],
      "ordering_rule": "FULL_SYSTEM_READY_is_not_a_prerequisite_for_DECISION_READY",
      "state_rule": "reuse_existing_decision_fact_pack_query_context_decision_context_and_e2e_contract; do_not_create_minimum_decision_state"
    },
    "decision_dependencies": {
      "SELL_HOLD": ["account", "holding_market_fact", "risk_reward", "alternatives"],
      "TRIAL": ["risk_permission", "candidate_evidence", "capital_state"],
      "CONFIRM": ["confirm_evidence", "lifecycle", "capital_state"],
      "DISCOVERY": ["universe", "cross_section", "history", "family_constraints"],
      "workflow_failure_rule": "workflow_failure_does_not_equal_decision_failure_when_canonical_required_facts_are_recoverable"
    },
    "state_builder_classification": {
      "HOT_PATH_REQUIRED": ["account", "holding_facts", "current_market_facts", "decision_relevant_intraday_path", "decision_relevant_discovery_projection"],
      "REUSABLE": ["market_regime", "market_structure", "validated_history", "skfolio_when_risk_relevant", "etf_share_flow_when_relevant", "margin_financing_when_relevant"],
      "ASYNC": ["research_features", "research_evidence_delta", "execution_quality", "low_cost_alpha", "active_return", "noncritical_research_enrichment"],
      "SLOW_PATH": ["contribution_audit", "research_master_candidates", "historical_backfill"],
      "AFTER_DECISION": ["dashboard_candidate", "review", "archive", "notification_enrichment", "experience"],
      "REMOVE_CANDIDATE": ["duplicate_projection_or_rebuild_without_current_decision_consumer"],
      "runtime_change_boundary": "classification_only_in_phase2; runtime_reordering_is_phase3"
    }
  }
}
