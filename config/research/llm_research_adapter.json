{
  "schema_version": "1.0",
  "enabled": false,
  "provider": "deepseek",
  "base_url": "https://api.deepseek.com",
  "model": "deepseek-chat",
  "timeout_seconds": 20,
  "max_output_tokens": 800,
  "max_retries": 1,
  "max_calls_per_invocation": 1,
  "daily_call_limit": 20,
  "daily_budget_usd": 0.50,
  "secret_env": "DEEPSEEK_API_KEY",
  "use_case": "post_market_review_research_critique",
  "fail_open": true,
  "persist_formal_state": false,
  "allow_trade_action": false
}
